# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional feature flags
# Chess.com public API is used by default. Set to true if Chess.com OAuth Partner approval is granted.
VITE_CHESSCOM_OAUTH_ENABLED=false

# Server/Script Configuration (Keep private, never expose to client)
# Used only by scripts/seed_admin.js
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAIL=coach@chesslogs.com
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_NAME="Coach Kasparov"
