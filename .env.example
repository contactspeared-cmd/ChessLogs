# ==============================================================================
# ChessLogs Configuration
# ==============================================================================

# Backend API Configuration
# When using Vite dev proxy, leave as /api
# In production or standalone, point to http://localhost:8000/api or your PHP host
VITE_API_BASE_URL=/api

# MySQL Database Configuration (Used by PHP Backend)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chesslogs
DB_USER=root
DB_PASS=

# Optional feature flags
# Chess.com public API is used by default. Set to true if Chess.com OAuth Partner approval is granted.
VITE_CHESSCOM_OAUTH_ENABLED=false

# Default Admin Seed Account
# Used in initial migration (database/schema.sql & database/migrate.php)
ADMIN_EMAIL=satoalt33@gmail.com
ADMIN_PASSWORD=ChessLogsAdmin2026!
ADMIN_NAME="Admin"
